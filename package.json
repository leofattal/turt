{
  "name": "turt",
  "version": "0.1.0",
  "description": "Turt — a modular AI foundation platform built from first principles: tensor math, autodiff, neural networks, tokenization, training, inference, memory, and tool use.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/quickstart.ts",
    "prepare-data": "tsx scripts/prepare-data.ts",
    "prepare-data-big": "tsx scripts/prepare-data-big.ts",
    "prepare-chat": "tsx scripts/prepare-chat.ts",
    "train": "tsx --max-old-space-size=8192 scripts/train-gpt.ts",
    "generate": "tsx scripts/generate.ts",
    "gpu-bench": "deno run --unstable-webgpu --unstable-sloppy-imports --allow-read scripts/gpu-bench.ts",
    "gpu-validate": "deno run --unstable-webgpu --unstable-sloppy-imports --allow-read scripts/gpu-ops-validate.ts",
    "gpu-gpt": "deno run --unstable-webgpu --unstable-sloppy-imports --allow-read scripts/gpu-gpt-validate.ts",
    "gpu-pretrain": "deno run --unstable-webgpu --unstable-sloppy-imports --allow-read --allow-write scripts/gpu-pretrain.ts",
    "gpu-pretrain-loop": "bash scripts/gpu-pretrain-loop.sh",
    "finetune-chat": "deno run --unstable-webgpu --unstable-sloppy-imports --allow-read --allow-write scripts/finetune-chat.ts",
    "chat": "tsx scripts/chat.ts",
    "serve": "tsx scripts/serve.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "ai",
    "tensor",
    "autodiff",
    "neural-network",
    "tokenizer",
    "from-scratch"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@webgpu/types": "^0.1.71",
    "eslint": "^10.7.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  }
}
